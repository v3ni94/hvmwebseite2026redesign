# Vorlage für .env (nie committen). Werte in eckigen Klammern sind offen.

# development | staging | production (fehlend oder unbekannt = production)
APP_ENV=development
APP_URL=http://127.0.0.1:8081
# 32 Byte für libsodium, erzeugen mit: php -r 'echo "base64:".base64_encode(random_bytes(32)).PHP_EOL;'
APP_KEY=
# true nur auf Staging: unfreigegebene Wissensartikel mit Entwurfskennzeichnung zeigen
SHOW_DRAFTS=false
PRICE_INDICATION_ENABLED=false
# KI-Crawler in robots.txt der Produktion zulassen (true) oder sperren (false), docs/seo-geo.md
AI_CRAWLERS=true

# Speicherung der Formulare (Entscheidung der Geschäftsführung vom 24.09.2026, docs/n8n-webhook.md):
# datei (Standard, Staging): keine Datenbank der Webseite, kein Admin-Bereich. Anfragen gehen als verschlüsselte
#   Aufträge über storage/outbox per signiertem Webhook an n8n (einzige dauerhafte Speicherung) und per Mail an
#   LEAD_NOTIFY_TO, danach werden die Dateien gelöscht.
# datenbank: bisheriger Betrieb mit MariaDB, Migrationen und Admin-Bereich (DB_* unten einkommentieren).
STORAGE_MODE=datei

# Datenbank: nur bei STORAGE_MODE=datenbank (in Docker setzt docker-compose.yml DB_HOST=db)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=hvm_dev
# DB_USER=hvm
# DB_PASSWORD=
# optional statt Host und Port
# DB_SOCKET=

# Testdatenbank für PHPUnit (fehlende Werte werden von DB_* übernommen), unabhängig von STORAGE_MODE
DB_TEST_NAME=hvm_test
DB_TEST_USER=
DB_TEST_PASSWORD=

# Mail (SMTP mit TLS)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=
MAIL_FROM_NAME="Hausverwaltung Müller GmbH"
# Pflicht bei STORAGE_MODE=datei: Empfänger der internen Benachrichtigungen [Empfängeradresse Leads festlegen]
LEAD_NOTIFY_TO=
# optional: Empfänger der Bewerbungen mit PDF-Anhang, leer = LEAD_NOTIFY_TO
BEWERBUNG_NOTIFY_TO=

# Outbox für Mail und Webhook: inline (Staging und Webhosting ohne Cronjob: Verarbeitung direkt nach der Antwort,
# docs/deploy-sftp.md) oder worker (Docker-Dienst "worker" bzw. Cronjob mit php bin/worker.php --once).
# Fehlt der Wert, gilt worker.
OUTBOX_MODE=inline

# Pflicht bei STORAGE_MODE=datei: Produktions-URL des n8n-Webhooks (https) [n8n-Webhook-URL]
N8N_WEBHOOK_URL=
# Pflicht bei STORAGE_MODE=datei: mindestens 32 zufällige Zeichen, derselbe Wert wird in n8n zur Signaturprüfung
# hinterlegt (docs/n8n-webhook.md). Erzeugen mit: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
N8N_WEBHOOK_SECRET=
# Produktion erlaubt nur https. true erlaubt http ausschließlich für interne Hosts
# (Docker-Dienstname ohne Punkt wie http://n8n:5678 oder private IP-Adresse)
N8N_WEBHOOK_ALLOW_HTTP_INTERNAL=false

# Nur das Subnetz des Traefik-Netzes (TRAEFIK_NETWORK), nie pauschal 172.16.0.0/12; lokal leer lassen.
# Traefik-Netz mit festem Subnetz anlegen bzw. prüfen (docs/betrieb.md Abschnitt 1.4):
#   docker network create --subnet 172.30.90.0/24 traefik
#   docker network inspect traefik -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=172.30.90.0/24
# leer = keine IP-Beschränkung für /admin/, sonst CIDR-Liste, kommagetrennt
ADMIN_IP_ALLOWLIST=
SESSION_IDLE_TIMEOUT=1800
# [Aufbewahrungsfrist festlegen], leer = Löschlauf der Datenbank deaktiviert. Im Dateimodus werden fehlgeschlagene
# Outbox-Aufträge nach dieser Frist, spätestens nach 30 Tagen gelöscht.
LEAD_RETENTION_DAYS=

# Nur für Tests: array hält Sitzungen im Speicher (phpunit.xml.dist setzt das selbst)
# SESSION_DRIVER=native

# Web-Einrichtung ohne Kommandozeile unter /_einrichtung/ (docs/deploy-sftp.md): mindestens 32 zufällige Zeichen,
# z. B. php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'. Leer = Einrichtung gesperrt (404).
# Nach Abschluss (storage/setup.lock) wieder entfernen.
SETUP_TOKEN=

# Deployment (docker-compose.yml)
COMPOSE_PROJECT_NAME=hvm-website
HVM_IMAGE=hvm-website
HVM_TAG=latest
# Staging: neu.muellerhv.de (bestätigt 24.09.2026), Produktion z. B. www.muellerhv.de
APP_HOST=
DB_ROOT_PASSWORD=
TRAEFIK_NETWORK=traefik
# Festes Subnetz des internen Compose-Netzes backend; Staging abweichend, z. B. 172.30.81.0/24
BACKEND_SUBNET=172.30.80.0/24
TRAEFIK_ROUTER=hvm
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Produktion: leer lassen (Standard <router>-compress@docker).
# Staging: hvm-staging-staging@docker,hvm-staging-compress@docker (bei TRAEFIK_ROUTER=hvm-staging)
TRAEFIK_MIDDLEWARES=
# Staging Basic Auth, in einfachen Anführungszeichen, Format benutzer:hash.
# Docker/Traefik: htpasswd-Format, z. B. 'benutzer:$apr1$...' (prüft Traefik, die Anwendung ignoriert apr1).
# Webhosting ohne Traefik: bcrypt- oder Argon2-Hash, z. B. 'benutzer:$2y$12$...' (Hash-Hilfe unter /_einrichtung/),
# dann verlangt die Anwendung selbst die Anmeldung (nur bei APP_ENV=staging, /health bleibt frei).
STAGING_BASIC_AUTH=
STAGING_ROBOTS_TAG="noindex, nofollow"

# Backup (bin/backup-db.sh, bin/restore-db.sh, docker/backup, siehe docs/betrieb.md)
BACKUP_METHOD=age
# [oeffentlicher age-Schluessel des Backup-Empfaengers]
BACKUP_AGE_RECIPIENT=
# nur fuer bin/restore-db.sh, nie auf dem Produktivserver ablegen
BACKUP_AGE_IDENTITY=
BACKUP_KEEP=14
