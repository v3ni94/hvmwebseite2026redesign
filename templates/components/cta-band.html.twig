{#
  CTA-Band (dunkel), Titel mit *Schlüsselwort*, bis zu zwei Aktionen, Orangekeil am oberen Rand.
  {% import 'components/cta-band.html.twig' as cta %}
  {{ cta.cta_band({titel: 'Angebot für Ihre *Immobilie*', text: '...', primaer: {label, url}, sekundaer: {label, url}, id: 'cta-titel'}) }}
#}
{% macro cta_band(o) %}
{%- import 'components/titel.html.twig' as t -%}
{%- import 'components/button.html.twig' as b -%}
<section class="c-cta-band is-dunkel"{% if o.id|default('') %} aria-labelledby="{{ o.id }}"{% endif %}>
    <span class="c-keil" aria-hidden="true"></span>
    <div class="l-container c-cta-band__inner" data-einblenden>
        <h2 class="c-cta-band__titel"{% if o.id|default('') %} id="{{ o.id }}"{% endif %}>{{ t.text(o.titel) }}</h2>
        {% if o.text|default('') %}<p class="c-cta-band__text">{{ o.text }}</p>{% endif %}
        <div class="c-aktionen">
            {% if o.primaer|default(null) %}{{ b.button(o.primaer.label, o.primaer.url, {variante: 'primaer', icon: 'pfeil'}) }}{% endif %}
            {% if o.sekundaer|default(null) %}{{ b.button(o.sekundaer.label, o.sekundaer.url, {variante: 'dunkel'}) }}{% endif %}
        </div>
    </div>
</section>
{% endmacro %}
