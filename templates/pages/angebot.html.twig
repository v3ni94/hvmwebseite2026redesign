{#
  Angebotsformular (MP 6.1). Ohne JavaScript ein einseitiges Formular mit allen Schritten,
  mit JavaScript (angebot.js) schrittweise mit Kennlinie als Fortschrittsanzeige.
  Zwischenstand nur im Speicher der Seite, kein Browser-Storage.
#}
{% extends 'layouts/base.html.twig' %}

{% import 'components/eyebrow.html.twig' as e %}
{% import 'components/form-fields.html.twig' as f %}
{% import 'components/notice.html.twig' as n %}

{% block content %}
<section class="c-seitenkopf c-seitenkopf--angebot">
    {% include 'partials/hausumriss.html.twig' with {klasse: 'c-seitenkopf__umriss'} only %}
    <div class="l-container c-seitenkopf__inhalt">
        {{ e.eyebrow('Unverbindliche Anfrage') }}
        <h1>Angebot anfordern</h1>
        <p class="c-seitenkopf__text">Für WEG-Verwaltung, Mietverwaltung oder SE-Verwaltung. Fünf kurze Schritte, danach erhalten Sie eine Rückmeldung von uns.</p>
    </div>
</section>

<section class="l-section l-section--kompakt u-mt-0 c-angebot" aria-label="Anfrageformular">
    <div class="l-container l-grid">
        <div class="l-span-8 c-angebot__haupt">
            {% if form.hinweis %}
            <div class="c-angebot__meldung" role="alert">
                {{ n.hinweis(form.hinweis.titel, form.hinweis.text, {typ: 'warnung'}) }}
            </div>
            {% endif %}

            {% include 'partials/forms/angebot/fehlerliste.html.twig' %}

            <div class="c-angebot__stepper" data-stepper hidden>
                {{ f.stepper(form.schritte, 1, {label: 'Fortschritt der Anfrage'}) }}
            </div>

            <form class="c-formular c-angebot__formular" action="{{ form.aktion }}" method="post" novalidate data-angebot{% if form.preise %} data-preise="{{ form.preise }}"{% endif %}{% if form.fehlerliste|length > 0 %} data-server-fehler{% endif %}>
                {{ csrf_field() }}
                <input type="hidden" name="{{ form.token_feld }}" value="{{ form.token }}">
                {% for name, wert in form.hidden %}
                <input type="hidden" name="{{ name }}" value="{{ wert }}">
                {% endfor %}
                <div class="c-angebot__hp" aria-hidden="true">
                    <label for="feld-{{ form.honeypot_feld }}">Dieses Feld bitte leer lassen</label>
                    <input type="text" id="feld-{{ form.honeypot_feld }}" name="{{ form.honeypot_feld }}" value="" tabindex="-1" autocomplete="off">
                </div>

                <p class="c-angebot__pflicht u-text-klein">Pflichtangaben sind mit „(Pflichtfeld)“ gekennzeichnet. Alle übrigen Angaben sind freiwillig und helfen uns bei der Einschätzung.</p>
                {% if form.region %}
                <p class="c-angebot__region u-text-klein">Anfrage für das Betreuungsgebiet <strong>{{ form.region }}</strong>.</p>
                {% endif %}

                {% include 'partials/forms/angebot/schritt-art.html.twig' %}
                {% include 'partials/forms/angebot/schritt-objekt.html.twig' %}
                {% include 'partials/forms/angebot/schritt-zeitpunkt.html.twig' %}
                {% include 'partials/forms/angebot/schritt-kontakt.html.twig' %}
                {% include 'partials/forms/angebot/schritt-absenden.html.twig' %}
            </form>
            <template id="angebot-fehler-vorlage"><p class="c-feld__fehler" data-client-fehler>{% include 'partials/icon.html.twig' with {name: 'fehler'} only %}<span><span class="u-visually-hidden">Fehler: </span><span data-fehler-text></span></span></p></template>
        </div>

        <aside class="l-span-4 c-angebot__seite" aria-labelledby="ablauf-titel">
            <div class="c-angebot__kasten">
                <h2 class="c-angebot__kasten-titel" id="ablauf-titel">So geht es weiter</h2>
                <ol class="c-angebot__ablauf" role="list">
                    <li><strong>Prüfung Ihrer Angaben</strong><span>Wir sehen uns Objekt und Anliegen an.</span></li>
                    <li><strong>Rückmeldung</strong><span>Wir melden uns bei Ihnen, um offene Fragen zu klären. Antwortzeit: {{ placeholder('Antwortzeit festlegen') }}</span></li>
                    <li><strong>Besichtigung und Angebot</strong><span>Sie erhalten ein individuelles Angebot, bei Bedarf nach einer Besichtigung des Objekts.</span></li>
                </ol>
            </div>
            <div class="c-angebot__kasten c-angebot__kasten--kontakt">
                <h2 class="c-angebot__kasten-titel">Lieber direkt?</h2>
                <p class="u-text-klein">
                    {% if firma.telefon %}Telefon <a href="{{ tel_href(firma.telefon) }}">{{ firma.telefon }}</a><br>{% endif %}
                    E-Mail <a href="mailto:{{ firma.email }}">{{ firma.email }}</a>
                </p>
            </div>
        </aside>
    </div>
</section>
{% endblock %}

{% block scripts %}
{{ parent() }}
<script type="module" src="{{ asset('angebot.js') }}" nonce="{{ csp_nonce() }}"></script>
{% endblock %}
