{#
  Betreuungsgebiete (Controller: Hvm\Controller\StadtController::index()): alle 42 PLZ-Bereiche aus
  config/staedte.php nach Bundesland gruppiert, mit PLZ-Bereich und Link zur Stadtseite (Link nur, wenn die
  Stadtseite in der Umgebung erreichbar ist). Karte ohne Google und ohne externe Anfragen (Inline-SVG,
  partials/karte-deutschland.html.twig), Hauptsitz hervorgehoben; die gruppierte Liste ist die Textalternative.
  Keine Anschriften je Stadt: offen, ob die Absenderadressen eigene Büros sind (docs/offene-punkte.md A6).
  Variablen: gruppen (Liste {bundesland, staedte}), orte (alle Städte für die Karte), anzahl.
#}
{% extends 'layouts/base.html.twig' %}

{% import 'components/eyebrow.html.twig' as e %}
{% import 'components/section-head.html.twig' as sh %}
{% import 'components/cta-band.html.twig' as cta %}
{% import 'pages/_bausteine.html.twig' as hvm %}

{% block hero %}
<section class="c-seitenkopf">
    {% include 'partials/hausumriss.html.twig' with {klasse: 'c-seitenkopf__umriss', zeichnen: true} only %}
    <div class="l-container c-seitenkopf__inhalt">
        {{ e.eyebrow('Regionen') }}
        <h1>{{ page.heading|trennen }}</h1>
        <p class="c-seitenkopf__text">Die Hausverwaltung Müller GmbH betreut Immobilien bundesweit in {{ anzahl }} Postleitzahlbereichen. Hauptsitz ist {{ firma.anschrift.strasse }}, {{ firma.anschrift.plz }} {{ firma.anschrift.ort }}. Wählen Sie die Region Ihres Objekts nach Bundesland oder Postleitzahl.</p>
        {{ hvm.hero_aktionen({label: 'Anfrage für Ihr Objekt', url: cta_url('/angebot/')}) }}
    </div>
</section>
{% endblock %}

{% block content %}

<section class="l-section" aria-labelledby="karte-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Karte',
            titel: 'Regionen im *Überblick*',
            text: 'Die Karte zeigt die ungefähre Lage der Städte, nach denen die Postleitzahlbereiche benannt sind. Es handelt sich nicht um Objekt- oder Büroadressen. Alle Angaben stehen als Text in der Liste nach Bundesländern.',
            id: 'karte-titel',
            geteilt: true,
        }) }}
        {% include 'partials/karte-deutschland.html.twig' with {orte: orte} only %}
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="gebiete-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Nach Bundesland',
            titel: 'Alle *Betreuungsgebiete*',
            text: 'Jeder Bereich ist nach einer Stadt benannt und umfasst die genannten Postleitzahlen, auch über Landesgrenzen hinweg. Die Zuordnung zum Bundesland richtet sich nach der namensgebenden Stadt.',
            id: 'gebiete-titel',
            geteilt: true,
        }) }}
        <div class="c-gebiete">
            {% for gruppe in gruppen %}
            <section class="c-gebiete__gruppe" aria-labelledby="land-{{ loop.index }}">
                <h3 class="c-gebiete__land" id="land-{{ loop.index }}">{{ gruppe.bundesland }}</h3>
                <ul class="c-gebiete__liste" role="list">
                    {% for s in gruppe.staedte %}
                    <li class="c-gebiete__eintrag{{ s.hauptsitz ? ' c-gebiete__eintrag--hauptsitz' }}">
                        <span class="c-gebiete__name">
                            {%- if s.url %}<a href="{{ s.url }}">Hausverwaltung {{ s.name }}</a>{% else %}{{ s.name }}{% endif -%}
                            {% if s.hauptsitz %} <span class="c-gebiete__marke">Hauptsitz</span>{% endif %}
                        </span>
                        <span class="c-gebiete__plz">PLZ {{ s.plz_von }} bis {{ s.plz_bis }}</span>
                    </li>
                    {% endfor %}
                </ul>
            </section>
            {% endfor %}
        </div>
    </div>
</section>

<section class="l-section" aria-labelledby="hauptsitz-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Hauptsitz',
            titel: 'Sitz in *' ~ firma.anschrift.ort ~ '*',
            text: firma.name ~ ', ' ~ firma.anschrift.strasse ~ ', ' ~ firma.anschrift.plz ~ ' ' ~ firma.anschrift.ort ~ '. Anfragen aus allen Betreuungsgebieten bearbeiten wir zentral, Besuche nach vorheriger Terminabstimmung.',
            id: 'hauptsitz-titel',
            aktion: {label: 'Kontakt und Anfahrt', url: '/kontakt/'},
        }) }}
    </div>
</section>

{{ cta.cta_band({
    titel: 'Anfrage mit *Region*',
    text: 'Nennen Sie uns Lage, Art und Größe Ihres Objekts, wir ordnen die Anfrage dem passenden Betreuungsgebiet zu.',
    primaer: {label: 'Anfrage stellen', url: cta_url('/angebot/')},
    sekundaer: {label: 'Kontakt aufnehmen', url: '/kontakt/'},
    id: 'cta-titel',
}) }}
{% endblock %}
