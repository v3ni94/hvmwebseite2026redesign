{#
  404: Suche und Kern-CTAs (docs/architektur.md Abschnitt 3). Kein Canonical, keine strukturierten Daten.
#}
{% extends 'layouts/base.html.twig' %}

{% import 'components/eyebrow.html.twig' as e %}
{% import 'components/form-fields.html.twig' as f %}
{% import 'components/button.html.twig' as b %}

{% block breadcrumbs %}{% endblock %}

{% block content %}
<section class="c-seitenkopf">
    {% include 'partials/hausumriss.html.twig' with {klasse: 'c-seitenkopf__umriss', zeichnen: true} only %}
    <div class="l-container c-seitenkopf__inhalt">
        <p class="c-fehlerseite__code" aria-hidden="true">404</p>
        {{ e.eyebrow('Fehler 404') }}
        <h1>Seite nicht gefunden</h1>
        <p class="c-seitenkopf__text">Die angeforderte Seite gibt es nicht oder nicht mehr. Die folgenden Wege führen weiter.</p>
        {{ f.suche({name: 'q', id: 'suche-404', label: 'Wissen und FAQ durchsuchen', platzhalter: 'Wissen und FAQ durchsuchen'}) }}
    </div>
</section>
<section class="l-section l-section--kompakt u-mt-0" aria-labelledby="wege-titel">
    <div class="l-container">
        <h2 class="u-visually-hidden" id="wege-titel">Weiterführende Seiten</h2>
        <ul class="c-fehlerseite__wege" role="list">
            <li><a href="/angebot/">Angebot anfordern {% include 'partials/icon.html.twig' with {name: 'pfeil'} only %}</a></li>
            <li><a href="/verwalterwechsel/">Verwalter wechseln {% include 'partials/icon.html.twig' with {name: 'pfeil'} only %}</a></li>
            <li><a href="/service/">Service für Mieter und Eigentümer {% include 'partials/icon.html.twig' with {name: 'pfeil'} only %}</a></li>
            <li><a href="/kontakt/">Kontakt {% include 'partials/icon.html.twig' with {name: 'pfeil'} only %}</a></li>
            <li><a href="/">Zur Startseite {% include 'partials/icon.html.twig' with {name: 'pfeil'} only %}</a></li>
        </ul>
    </div>
</section>
{% endblock %}
