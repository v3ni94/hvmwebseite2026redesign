{#
  SE-Verwaltung (Sondereigentumsverwaltung): Betreuung der einzelnen vermieteten Eigentumswohnung
  für Kapitalanleger, Abgrenzung und Schnittstelle zur WEG-Verwaltung.
  Leistungsumfang: docs/leistungsverzeichnis.md (aus den Muster-Angeboten, Stand 24.09.2026).
  Grundlage: docs/quellen/masterprompt-relaunch-muellerhv-de.md Abschnitt 3.5, 5, 8; docs/architektur.md Abschnitt 9.
  Alle Texte sind Entwürfe, keine Rechtsberatung.
#}
{% extends 'layouts/base.html.twig' %}

{% import 'components/eyebrow.html.twig' as e %}
{% import 'components/section-head.html.twig' as sh %}
{% import 'components/card.html.twig' as c %}
{% import 'components/timeline.html.twig' as tl %}
{% import 'components/faq.html.twig' as faq %}
{% import 'components/notice.html.twig' as n %}
{% import 'components/cta-band.html.twig' as cta %}
{% import 'pages/_bausteine.html.twig' as hvm %}

{% block hero %}
<section class="c-seitenkopf">
    {% include 'partials/hausumriss.html.twig' with {klasse: 'c-seitenkopf__umriss', zeichnen: true} only %}
    <div class="l-container c-seitenkopf__inhalt">
        {{ e.eyebrow('Leistungen') }}
        <h1>{{ page.heading|trennen }}</h1>
        <p class="c-seitenkopf__text">Die Hausverwaltung Müller GmbH betreut für <strong>Kapitalanleger</strong> die einzelne vermietete Eigentumswohnung: Mietverhältnis, Mieteingang, Betriebskostenabrechnung gegenüber dem Mieter und die Abstimmung mit der WEG-Verwaltung des Objekts.</p>
        {{ hvm.hero_aktionen({label: 'Angebot anfordern', url: cta_url('/angebot/', {art: 'se'})}) }}
    </div>
</section>
{% endblock %}

{% block content %}

{{ hvm.vertrauen({punkte: ['seit', 'bestand', 'verbaende', 'notdienst', 'portal', 'aufnahmegebuehr']}) }}

<section class="l-section l-section--kompakt" aria-labelledby="fuer-wen-titel">
    <div class="l-container">
        {{ sh.section_head({
            titel: 'Für *Kapitalanleger* mit vermieteter Eigentumswohnung',
            text: 'Die SE-Verwaltung richtet sich an Eigentümer einer einzelnen, vermieteten Wohnung innerhalb einer Wohnungs­eigentümer­gemeinschaft. Sie betrifft nur das Sondereigentum, also die einzelne Wohnung samt Mietverhältnis, nicht die Verwaltung des Gemeinschaftseigentums.',
            id: 'fuer-wen-titel',
        }) }}
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="abgrenzung-weg-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Abgrenzung',
            titel: 'SE-Verwaltung und *WEG-Verwaltung* im Unterschied',
            text: 'Die WEG-Verwaltung handelt als Organ der Gemeinschaft der Wohnungseigentümer und betreut das gemeinschaftliche Eigentum, etwa Dach, Fassade und Treppenhaus, im Auftrag aller Eigentümer gemeinsam. Die SE-Verwaltung betreut im Auftrag des einzelnen Eigentümers dessen Sondereigentum, also die einzelne Wohnung und das dazugehörige Mietverhältnis. Beide Leistungen ergänzen sich, sind aber rechtlich und organisatorisch getrennt.',
            id: 'abgrenzung-weg-titel',
            geteilt: true,
            aktion: {label: 'Zur WEG-Verwaltung', url: '/weg-verwaltung/'},
        }) }}
    </div>
</section>

<section class="l-section" aria-labelledby="leistungsumfang-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Leistungsumfang',
            titel: 'Grundleistungen der *SE-Verwaltung*',
            text: 'Die folgenden laufenden Leistungen für Ihr Sondereigentum sind in der Regel mit der monatlichen Grundvergütung abgegolten. Maßgeblich ist der individuelle Verwaltervertrag.',
            id: 'leistungsumfang-titel',
            geteilt: true,
        }) }}
        <div class="c-karten">
            {% set kaufmaennisch %}
            <ul class="c-leistungsliste">
                <li>Mietverwaltung einschließlich Buchführung und Belegsammlung</li>
                <li>Erfassung und Buchung der Mietzahlungen, Abwicklung des Zahlungsverkehrs</li>
                <li>Mahnwesen bei Mietrückständen einschließlich Einleitung weiterführender Schritte</li>
                <li>Erstellung und fristgerechte Zustellung der Betriebskostenabrechnung gegenüber dem Mieter</li>
                <li>Regelmäßige Überprüfung des Mietniveaus mit Anpassungsvorschlägen</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Kaufmännisch', ton: 'w', nummer: '01', zusatz: kaufmaennisch}) }}
            {% set technisch %}
            <ul class="c-leistungsliste">
                <li>Überwachung technischer Anlagen im Sondereigentum, soweit nicht Gemeinschaftseigentum</li>
                <li>Ermittlung des Instandhaltungsbedarfs und Planung der Maßnahmen</li>
                <li>Kaufmännische Betreuung von Instandhaltungsmaßnahmen bis zu einer vertraglich festgelegten Wertgrenze je Einzelmaßnahme</li>
                <li>Koordination und Kontrolle von Dienstleistern</li>
                <li>Jährliche Wohnungsbegehung</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Technisch', ton: 'w', nummer: '02', zusatz: technisch}) }}
            {% set organisatorisch %}
            <ul class="c-leistungsliste">
                <li>Abschluss, Änderung und Kündigung von Mietverträgen</li>
                <li>Wohnungsabnahmen und Übergaben bei Mieterwechseln mit Protokoll</li>
                <li>Kommunikation mit Mietern, Behörden und Dienstleistern</li>
                <li>Erster Ansprechpartner für die Mieterin oder den Mieter</li>
                <li>24-Stunden-Notruf</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Mieterbetreuung', ton: 'w', nummer: '03', zusatz: organisatorisch}) }}
        </div>
        {{ hvm.zwischen_cta('Sie vermieten eine Eigentumswohnung und möchten die Betreuung abgeben? Sie erhalten ein schriftliches Angebot für Ihre Wohnung.', {label: 'Angebot anfordern', url: cta_url('/angebot/', {art: 'se'})}, {label: 'Zur WEG-Verwaltung', url: '/weg-verwaltung/'}) }}
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="schnittstelle-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Schnittstelle',
            titel: 'Zusammenarbeit mit der *WEG-Verwaltung*',
            id: 'schnittstelle-titel',
        }) }}
        {{ n.hinweis('Schnittstelle zur WEG-Verwaltung', 'Ist die Hausverwaltung Müller GmbH auch für die WEG-Verwaltung des Objekts beauftragt, sind die Wege kurz. Führt eine andere Verwaltung die WEG, stimmen wir uns mit dieser zu Beschlüssen, Wirtschaftsplan und Erhaltungsrücklage ab. Eine Vertretung in der Eigentümerversammlung übernehmen wir nur mit gesonderter Vollmacht in Textform und nach Absprache.') }}
    </div>
</section>

<section class="l-section" aria-labelledby="sonderleistungen-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Sonderleistungen',
            titel: 'Was *gesondert* vergütet wird',
            text: 'Leistungen außerhalb der laufenden Verwaltung werden in der Regel gesondert vergütet, meist nach Zeitaufwand mit Nachweis. Die Einzelheiten regelt der Verwaltervertrag.',
            id: 'sonderleistungen-titel',
            geteilt: true,
            aktion: {label: 'Grund- und Sonderleistungen erklärt', url: '/wissen/sonderleistungen-verwaltung/'},
        }) }}
        <div class="c-karten">
            {% set sonder_vermietung %}
            <ul class="c-leistungsliste">
                <li>Ermittlung des marktgerechten Mietpreises</li>
                <li>Inserat, Organisation und Durchführung von Besichtigungen</li>
                <li>Prüfung der Mietinteressenten</li>
                <li>Mietvertrag und Wohnungsübergabe mit Protokoll</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Neuvermietung', text: 'Vergütung nur bei erfolgreicher Vermittlung.', ton: 'm', zusatz: sonder_vermietung}) }}
            {% set sonder_miete %}
            <ul class="c-leistungsliste">
                <li>Vorbereitung und Durchführung von Mieterhöhungen, in der Regel nach Aufwand</li>
                <li>Größere Bau- und Erhaltungsmaßnahmen oberhalb der Wertgrenze</li>
                <li>Außergewöhnliche Schadensfälle mit mehreren Begehungen und Handwerkerterminen</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Mieterhöhung, Bau und Schäden', ton: 'm', zusatz: sonder_miete}) }}
            {% set sonder_recht %}
            <ul class="c-leistungsliste">
                <li>Koordination und Zuarbeit bei Rechtsstreitigkeiten, die grundsätzlich an Rechtsanwälte vergeben werden</li>
                <li>Sonstige Arbeiten außerhalb der üblichen Verwaltertätigkeit</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Recht und Sonderarbeiten', ton: 'm', zusatz: sonder_recht}) }}
        </div>
        <div class="c-karten--abstand">
            {{ n.hinweis('Vertragsbedingungen und Abgrenzung', 'Die Verwaltung des Gemeinschaftseigentums ist nicht Teil der SE-Verwaltung, hierfür siehe WEG-Verwaltung. Rechtsberatung und Prozessführung sind nicht geschuldet. Im ersten Vertragsjahr besteht in der Regel ein monatliches Sonderkündigungsrecht, danach verlängert sich der Vertrag jeweils um ein Jahr, sofern er nicht fristgerecht gekündigt wird. Die Vergütung kann auf Wunsch für eine vereinbarte Laufzeit festgeschrieben werden.', {typ: 'info'}) }}
        </div>
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="ablauf-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Übernahme',
            titel: 'Ablauf der *Übernahme*',
            text: 'Der Wechsel in die SE-Verwaltung der Hausverwaltung Müller GmbH folgt einem geordneten Ablauf.',
            id: 'ablauf-titel',
        }) }}
        {{ tl.timeline([
            {titel: 'Bestandsaufnahme und Angebot', text: 'Sie schildern die Wohnung, das Mietverhältnis und die zuständige WEG-Verwaltung, Sie erhalten ein schriftliches Angebot.'},
            {titel: 'Verwaltungsvertrag', text: 'Sie beauftragen die Hausverwaltung Müller GmbH mit der SE-Verwaltung.'},
            {titel: 'Übergabe der Unterlagen', text: 'Mietvertrag, Kontodaten und WEG-Unterlagen zur Einheit werden übergeben.'},
            {titel: 'Start der Verwaltung', text: 'Mieterin oder Mieter sowie die WEG-Verwaltung werden informiert, die laufende Verwaltung beginnt.'},
        ]) }}
    </div>
</section>

<section class="l-section" aria-labelledby="mehrwerte-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Service und Konditionen',
            titel: 'Portal, Notdienst und *Rahmenverträge*',
            id: 'mehrwerte-titel',
        }) }}
        {% set portal_zusatz %}{% if firma.portal_url %}Zugang über das Portal der Hausverwaltung.{% else %}{{ placeholder(firma.portal_url_platzhalter) }}{% endif %}{% endset %}
        {% set notfall_zusatz %}Erreichbarkeit außerhalb der Bürozeiten, Nummer {{ firma.notfall_telefon ?: placeholder(firma.notfall_telefon_platzhalter) }}{% endset %}
        <div class="c-karten c-karten--4">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Eigentümerportal mit Ticketsystem', icon: 'portal', url: firma.portal_url ?: '/service/', fuss: 'Zum Portal', text: 'Abrechnungen, Belege und Unterlagen digital abrufen, Anliegen online übermitteln.', zusatz: portal_zusatz}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: '24/7-Notdienst', icon: 'notfall', url: '/notfall/', fuss: 'Zur Notfallseite', text: 'Rund um die Uhr erreichbar bei einem Notfall im Objekt.', zusatz: notfall_zusatz}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Rahmenverträge', icon: 'dokument', text: 'Abgestimmte Rahmenverträge für Versicherung, Gas, Strom, Hausmeisterdienste und Messdienst.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Keine Aufnahmegebühr', icon: 'info', text: 'Für den Wechsel zur Hausverwaltung Müller GmbH fällt keine Aufnahmegebühr an.'}) }}
        </div>
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="wissen-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Wissen',
            titel: 'Weiterführende *Beiträge*',
            id: 'wissen-titel',
            aktion: {label: 'Alle Beiträge für Vermieter und Investoren', url: '/wissen/?zielgruppe=vermieter-investoren'},
        }) }}
        <div class="c-karten c-karten--4">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Sondereigentumsverwaltung für Kapitalanleger', url: '/wissen/sondereigentumsverwaltung/', fuss: 'Beitrag lesen', text: 'Leistungsumfang und Abgrenzung im Überblick.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Die Betriebskostenabrechnung für Vermieter', url: '/wissen/betriebskostenabrechnung/', fuss: 'Beitrag lesen', text: 'Ablauf und Fristen der Abrechnung.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Die Eigentümerversammlung', url: '/wissen/eigentuemerversammlung/', fuss: 'Beitrag lesen', text: 'Einberufung, Ablauf und Niederschrift.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Was kostet eine Hausverwaltung?', url: '/wissen/kosten-hausverwaltung/', fuss: 'Beitrag lesen', text: 'Faktoren für die Vergütung der Verwaltung.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Mietverwaltung oder SE-Verwaltung: was passt?', url: '/wissen/mietverwaltung-oder-se-verwaltung/', fuss: 'Beitrag lesen', text: 'Welche Verwaltungsform zu welcher Immobilie passt.'}) }}
        </div>
    </div>
</section>

<section class="l-section" aria-labelledby="faq-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Häufige Fragen',
            titel: 'Kurz *erklärt*',
            id: 'faq-titel',
        }) }}
        {{ faq.faq([
            {frage: 'Vertritt die SE-Verwaltung mich auch in der Eigentümerversammlung?', antwort: 'Nur mit gesonderter Vollmacht in Textform und nach vorheriger Absprache, soweit die Gemeinschaftsordnung die Vertretung nicht beschränkt. Grundsätzlich betreuen wir das Sondereigentum, nicht die Vertretung in der Gemeinschaft.'},
            {frage: 'Kann die Hausverwaltung Müller GmbH auch die WEG-Verwaltung des Objekts übernehmen?', antwort: 'Das prüfen wir im Einzelfall. Ist die Gemeinschaft daran interessiert, kann ein Wechsel der WEG-Verwaltung gesondert beschlossen werden.'},
            {frage: 'Was passiert, wenn meine Wohnung leer steht?', antwort: 'Bei einem Mieterwechsel übernehmen wir die Neuvermietung von der Mietpreisermittlung bis zur Wohnungsübergabe. Sie ist nicht in der Grundvergütung enthalten und wird in der Regel nur bei erfolgreicher Vermittlung vergütet, siehe auch Vermietung.'},
        ]) }}
    </div>
</section>

{{ hvm.erreichbarkeit({flaeche: true}) }}

{{ cta.cta_band({
    titel: 'Angebot für Ihre *Eigentumswohnung* anfordern',
    text: 'Unverbindlich und nur mit den Angaben, die für ein Angebot erforderlich sind.',
    primaer: {label: 'Angebot anfordern', url: cta_url('/angebot/', {art: 'se'})},
    sekundaer: {label: 'Kontakt aufnehmen', url: '/kontakt/'},
    id: 'cta-titel',
}) }}
{% endblock %}
