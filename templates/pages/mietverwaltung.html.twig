{#
  Mietverwaltung: Leistungsumfang und Ablauf für Vermieter und Investoren.
  Leistungsumfang: docs/leistungsverzeichnis.md (aus den Muster-Angeboten, Stand 24.09.2026).
  Grundlage: docs/quellen/masterprompt-relaunch-muellerhv-de.md Abschnitt 3.5, 5, 8; docs/architektur.md Abschnitt 9.
  Alle Texte sind Entwürfe, keine Rechtsberatung.
#}
{% extends 'layouts/base.html.twig' %}

{% import 'components/eyebrow.html.twig' as e %}
{% import 'components/section-head.html.twig' as sh %}
{% import 'components/card.html.twig' as c %}
{% import 'components/timeline.html.twig' as tl %}
{% import 'components/faq.html.twig' as faq %}
{% import 'components/notice.html.twig' as n %}
{% import 'components/cta-band.html.twig' as cta %}
{% import 'pages/_bausteine.html.twig' as hvm %}

{% block hero %}
<section class="c-seitenkopf">
    {% include 'partials/hausumriss.html.twig' with {klasse: 'c-seitenkopf__umriss', zeichnen: true} only %}
    <div class="l-container c-seitenkopf__inhalt">
        {{ e.eyebrow('Leistungen') }}
        <h1>{{ page.heading|trennen }}</h1>
        <p class="c-seitenkopf__text">Die Hausverwaltung Müller GmbH aus {{ firma.anschrift.ort }} übernimmt für <strong>Vermieter und Investoren</strong> die laufende Verwaltung vermieteter Wohn- und Gewerbeeinheiten: Mietverträge, Mieteingang und Mahnwesen, Betriebskostenabrechnung, Mieterhöhungen und Instandhaltung.</p>
        {{ hvm.hero_aktionen({label: 'Angebot anfordern', url: cta_url('/angebot/', {art: 'miet'})}) }}
    </div>
</section>
{% endblock %}

{% block content %}

{{ hvm.vertrauen({punkte: ['seit', 'bestand', 'verbaende', 'notdienst', 'portal', 'aufnahmegebuehr']}) }}

<section class="l-section l-section--kompakt" aria-labelledby="fuer-wen-titel">
    <div class="l-container">
        {{ sh.section_head({
            titel: 'Für *Vermieter* und Investoren',
            text: 'Die Mietverwaltung richtet sich an Eigentümer vermieteter Wohn- und Gewerbeeinheiten, vom Einzeleigentümer bis zum Investor mit mehreren Objekten. Grundlage ist ein bestehendes oder neu abgeschlossenes Mietverhältnis. Bei einem Mieterwechsel übernimmt die Hausverwaltung Müller GmbH auch die Neuvermietung, die in der Regel nur bei erfolgreicher Vermittlung gesondert vergütet wird, siehe Vermietung.',
            id: 'fuer-wen-titel',
            geteilt: true,
            aktion: {label: 'Zur Vermietung', url: '/vermietung/'},
        }) }}
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="leistungsumfang-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Leistungsumfang',
            titel: 'Grundleistungen der *Mietverwaltung*',
            text: 'Die folgenden laufenden Leistungen sind in der Regel mit der monatlichen Grundvergütung abgegolten. Maßgeblich ist der individuelle Verwaltungsvertrag.',
            id: 'leistungsumfang-titel',
            geteilt: true,
        }) }}
        <div class="c-karten">
            {% set kaufmaennisch %}
            <ul class="c-leistungsliste">
                <li>Erfassung der Stammdaten von Objekt und Mietern</li>
                <li>Erfassung und Buchung der Mietzahlungen, Abwicklung des Zahlungsverkehrs</li>
                <li>Mahnwesen bei Mietrückständen einschließlich Einleitung weiterführender Schritte</li>
                <li>Erstellung und fristgerechte Zustellung der Nebenkostenabrechnungen</li>
                <li>Vorschläge zur Anpassung der Betriebskostenvorauszahlungen</li>
                <li>Regelmäßige Überprüfung des Mietniveaus mit Anpassungsvorschlägen</li>
                <li>Jährliche Einnahmen- und Ausgabenübersicht</li>
                <li>Entrichtung öffentlicher Abgaben und wiederkehrender Lasten</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Kaufmännisch', ton: 'w', nummer: '01', zusatz: kaufmaennisch}) }}
            {% set technisch %}
            <ul class="c-leistungsliste">
                <li>Überwachung technischer Anlagen wie Heizung, Warmwasser und Aufzug</li>
                <li>Bedarfsgerechte Objektbegehungen und jährliche Wohnungsbegehungen</li>
                <li>Ermittlung des Instandhaltungsbedarfs und Planung der Maßnahmen</li>
                <li>Kaufmännische Betreuung von Instandhaltungsmaßnahmen bis zu einer vertraglich festgelegten Wertgrenze je Einzelmaßnahme</li>
                <li>Abschluss und Kündigung von Wartungs-, Liefer- und Versorgungsverträgen</li>
                <li>Koordination und Kontrolle von Dienstleistern, Räum- und Streupläne</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Technisch', ton: 'w', nummer: '02', zusatz: technisch}) }}
            {% set organisatorisch %}
            <ul class="c-leistungsliste">
                <li>Abschluss, Änderung und Kündigung von Mietverträgen</li>
                <li>Wohnungsabnahmen und Übergaben bei Mieterwechseln mit Protokoll</li>
                <li>Erster Ansprechpartner für Mieterinnen und Mieter</li>
                <li>24-Stunden-Notruf</li>
                <li>Vertretung gegenüber Behörden und öffentlichen Stellen</li>
                <li>Information des Eigentümers über wichtige oder ungewöhnliche Vorgänge</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Mieterverwaltung', ton: 'w', nummer: '03', zusatz: organisatorisch}) }}
        </div>
        {{ hvm.zwischen_cta('Sie möchten die Verwaltung Ihrer Mietobjekte abgeben? Schildern Sie uns Objekt und Anzahl der Einheiten, Sie erhalten ein schriftliches Angebot.', {label: 'Angebot anfordern', url: cta_url('/angebot/', {art: 'miet'})}, {label: 'Zur Vermietung', url: '/vermietung/'}) }}
    </div>
</section>

<section class="l-section" aria-labelledby="sonderleistungen-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Sonderleistungen',
            titel: 'Was *gesondert* vergütet wird',
            text: 'Leistungen außerhalb der laufenden Verwaltung werden in der Regel gesondert vergütet, meist nach Zeitaufwand mit Nachweis. Die Einzelheiten regelt der Verwaltungsvertrag.',
            id: 'sonderleistungen-titel',
            geteilt: true,
            aktion: {label: 'Grund- und Sonderleistungen erklärt', url: '/wissen/sonderleistungen-verwaltung/'},
        }) }}
        <div class="c-karten">
            {% set sonder_vermietung %}
            <ul class="c-leistungsliste">
                <li>Ermittlung des marktgerechten Mietpreises</li>
                <li>Inserat, Organisation und Durchführung von Besichtigungen</li>
                <li>Prüfung der Mietinteressenten</li>
                <li>Mietvertrag und Wohnungsübergabe mit Protokoll</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Neuvermietung', text: 'Vergütung nur bei erfolgreicher Vermittlung.', ton: 'm', zusatz: sonder_vermietung}) }}
            {% set sonder_bau %}
            <ul class="c-leistungsliste">
                <li>Größere Bau- und Erhaltungsmaßnahmen oberhalb der Wertgrenze</li>
                <li>Außergewöhnliche Schadensfälle mit mehreren Begehungen und Handwerkerterminen, etwa größere Wasser- oder Brandschäden</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Baumaßnahmen und Schäden', ton: 'm', zusatz: sonder_bau}) }}
            {% set sonder_recht %}
            <ul class="c-leistungsliste">
                <li>Koordination und Zuarbeit bei Rechtsstreitigkeiten, Anwalts- und Gerichtskosten trägt der Eigentümer</li>
                <li>Sonstige Arbeiten außerhalb der üblichen Verwaltertätigkeit</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Recht und Sonderarbeiten', ton: 'm', zusatz: sonder_recht}) }}
        </div>
        <div class="c-karten--abstand">
            {{ n.hinweis('Vertragsbedingungen und Abgrenzung', 'Im ersten Vertragsjahr besteht in der Regel ein monatliches Sonderkündigungsrecht, danach verlängert sich der Vertrag jeweils um ein Jahr, sofern er nicht fristgerecht gekündigt wird. Die Vergütung kann auf Wunsch für eine vereinbarte Laufzeit festgeschrieben werden. Rechtsberatung ist nicht Teil der Mietverwaltung, bei Bedarf wird im Namen des Eigentümers ein Rechtsanwalt beauftragt.') }}
        </div>
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="ablauf-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Übernahme',
            titel: 'Ablauf der *Übernahme*',
            text: 'Der Wechsel in die Mietverwaltung der Hausverwaltung Müller GmbH folgt einem geordneten Ablauf.',
            id: 'ablauf-titel',
        }) }}
        {{ tl.timeline([
            {titel: 'Bestandsaufnahme und Angebot', text: 'Sie schildern Objekt, Mietverhältnisse und Ausgangslage, Sie erhalten ein schriftliches Angebot.'},
            {titel: 'Verwaltungsvertrag', text: 'Sie beauftragen die Hausverwaltung Müller GmbH mit der Mietverwaltung.'},
            {titel: 'Übergabe der Unterlagen', text: 'Mietverträge, Kontodaten und laufende Vorgänge werden übergeben.'},
            {titel: 'Start der Verwaltung', text: 'Mieterinnen und Mieter sowie Dienstleister werden informiert, die laufende Verwaltung beginnt.'},
        ]) }}
    </div>
</section>

<section class="l-section" aria-labelledby="mehrwerte-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Service und Konditionen',
            titel: 'Portal, Notdienst und *Rahmenverträge*',
            id: 'mehrwerte-titel',
        }) }}
        {% set portal_zusatz %}{% if firma.portal_url %}Zugang über das Portal der Hausverwaltung.{% else %}{{ placeholder(firma.portal_url_platzhalter) }}{% endif %}{% endset %}
        {% set notfall_zusatz %}Erreichbarkeit außerhalb der Bürozeiten, Nummer {{ firma.notfall_telefon ?: placeholder(firma.notfall_telefon_platzhalter) }}{% endset %}
        <div class="c-karten c-karten--4">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Eigentümerportal mit Ticketsystem', icon: 'portal', url: firma.portal_url ?: '/service/', fuss: 'Zum Portal', text: 'Abrechnungen, Belege und Unterlagen digital abrufen, Anliegen online übermitteln.', zusatz: portal_zusatz}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: '24/7-Notdienst', icon: 'notfall', url: '/notfall/', fuss: 'Zur Notfallseite', text: 'Rund um die Uhr erreichbar bei einem Notfall im Objekt.', zusatz: notfall_zusatz}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Rahmenverträge', icon: 'dokument', text: 'Abgestimmte Rahmenverträge für Versicherung, Gas, Strom, Hausmeisterdienste und Messdienst.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Keine Aufnahmegebühr', icon: 'info', text: 'Für den Wechsel zur Hausverwaltung Müller GmbH fällt keine Aufnahmegebühr an.'}) }}
        </div>
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="wissen-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Wissen',
            titel: 'Weiterführende *Beiträge*',
            id: 'wissen-titel',
            aktion: {label: 'Alle Beiträge für Vermieter und Investoren', url: '/wissen/?zielgruppe=vermieter-investoren'},
        }) }}
        <div class="c-karten c-karten--4">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Mietverwaltung: Aufgaben und Leistungsumfang', url: '/wissen/mietverwaltung-leistungen/', fuss: 'Beitrag lesen', text: 'Der Leistungsumfang im Überblick.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Die Betriebskostenabrechnung für Vermieter', url: '/wissen/betriebskostenabrechnung/', fuss: 'Beitrag lesen', text: 'Ablauf und Fristen der Abrechnung.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Was kostet eine Hausverwaltung?', url: '/wissen/kosten-hausverwaltung/', fuss: 'Beitrag lesen', text: 'Faktoren für die Vergütung der Verwaltung.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Was ist in der Verwaltung enthalten?', url: '/wissen/leistungsumfang-verwaltervertrag/', fuss: 'Beitrag lesen', text: 'Leistungsumfang des Verwaltervertrags.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Instandhaltungsplanung für Bestandsimmobilien', url: '/wissen/instandhaltungsplanung-bestand/', fuss: 'Beitrag lesen', text: 'Zustandserfassung, Prioritäten und Budget im Überblick.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Mieterhöhung bis zur ortsüblichen Vergleichsmiete', url: '/wissen/mieterhoehung-vergleichsmiete/', fuss: 'Beitrag lesen', text: 'Voraussetzungen, Wartefrist und Kappungsgrenze.'}) }}
        </div>
    </div>
</section>

<section class="l-section" aria-labelledby="faq-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Häufige Fragen',
            titel: 'Kurz *erklärt*',
            id: 'faq-titel',
        }) }}
        {{ faq.faq([
            {frage: 'Übernimmt die Mietverwaltung auch die Neuvermietung?', antwort: 'Ja, bei einem Mieterwechsel übernehmen wir die Neuvermietung von der Mietpreisermittlung bis zur Wohnungsübergabe. Sie ist nicht in der Grundvergütung enthalten und wird in der Regel nur bei erfolgreicher Vermittlung vergütet. Informationen dazu finden Sie auf der Seite Vermietung.'},
            {frage: 'Was geschieht bei einem Zahlungsrückstand des Mieters?', antwort: 'Das Mahnwesen einschließlich der Einleitung weiterführender Schritte gehört zur laufenden Verwaltung. Ist ein Rechtsstreit erforderlich, wird in der Regel ein Rechtsanwalt beauftragt. Unsere Koordination wird dann nach Aufwand vergütet, Anwalts- und Gerichtskosten tragen Sie als Eigentümer.'},
            {frage: 'Wie oft erhalte ich eine Abrechnung zu meiner Immobilie?', antwort: 'In der Regel erhalten Sie einmal jährlich eine Abrechnung über das Verwaltungskonto mit den Belegen sowie eine Einnahmen- und Ausgabenübersicht. Über wichtige oder ungewöhnliche Vorgänge informieren wir Sie unverzüglich. Die Mieteinnahmen werden monatlich an Sie ausgezahlt.'},
        ]) }}
    </div>
</section>

{{ hvm.erreichbarkeit({flaeche: true}) }}

{{ cta.cta_band({
    titel: 'Angebot für Ihre *Mietimmobilie* anfordern',
    text: 'Unverbindlich und nur mit den Angaben, die für ein Angebot erforderlich sind.',
    primaer: {label: 'Angebot anfordern', url: cta_url('/angebot/', {art: 'miet'})},
    sekundaer: {label: 'Kontakt aufnehmen', url: '/kontakt/'},
    id: 'cta-titel',
}) }}
{% endblock %}
