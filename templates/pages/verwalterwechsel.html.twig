{#
  Verwalterwechsel: wichtigste Landingpage. Ablauf als Zeitleiste, Zeitplan ohne erfundene Fristen,
  Checkliste Unterlagenübergabe, Hinweis zur Beschlussfassung.
  Grundlage: docs/quellen/masterprompt-relaunch-muellerhv-de.md Abschnitt 3.5, 5, 8; docs/architektur.md Abschnitt 9.
  Alle Texte sind Entwürfe, keine Rechtsberatung, Fristen werden nicht erfunden.
#}
{% extends 'layouts/base.html.twig' %}

{% import 'components/button.html.twig' as b %}
{% import 'components/eyebrow.html.twig' as e %}
{% import 'components/section-head.html.twig' as sh %}
{% import 'components/card.html.twig' as c %}
{% import 'components/timeline.html.twig' as tl %}
{% import 'components/faq.html.twig' as faq %}
{% import 'components/notice.html.twig' as n %}
{% import 'components/cta-band.html.twig' as cta %}
{% import 'pages/_bausteine.html.twig' as hvm %}

{% block hero %}
<section class="c-hero c-hero--mit-keil">
    <div class="c-hero__umriss-rahmen" aria-hidden="true">
        {% include 'partials/hausumriss.html.twig' with {klasse: 'c-hero__umriss', zeichnen: true, parallaxe: true} only %}
    </div>
    <div class="l-container">
        <div class="c-hero__inhalt">
            {{ e.eyebrow('Verwalterwechsel', {klasse: 'u-auftritt'}) }}
            <hgroup class="c-display c-hero__titel u-auftritt u-auftritt--2" data-kinetisch>
                <h1>Verwalterwechsel</h1><p> für Ihre <strong>Eigentümer&shy;gemeinschaft</strong>, geordnet und nachvollziehbar.</p>
            </hgroup>
            <p class="c-hero__lead u-auftritt u-auftritt--3">Die Hausverwaltung Müller GmbH übernimmt die Verwaltung Ihrer Wohnungs&shy;eigentümer&shy;gemeinschaft und begleitet den Wechsel vom Beschluss der Eigentümer&shy;versammlung bis zur Übergabe der Unterlagen. Sie erhalten ein Angebot mit Vertragsentwurf, eine Aufnahmegebühr fällt nicht an.</p>
            {{ hvm.hero_aktionen({label: 'Wechsel anfragen', url: cta_url('/angebot/', {anlass: 'wechsel'})}, {klasse: 'u-auftritt u-auftritt--4'}) }}
        </div>
    </div>
    <span class="c-keil c-keil-uebergang" aria-hidden="true"></span>
</section>
{% endblock %}

{% block content %}

{{ hvm.vertrauen() }}

<section class="l-section l-section--kompakt" aria-labelledby="fuer-wen-titel">
    <div class="l-container">
        {{ sh.section_head({
            titel: 'Für *Eigentümergemeinschaften* und Beiräte',
            text: 'Diese Seite richtet sich an Wohnungs­eigentümer­gemeinschaften und ihre Beiräte, die einen Wechsel der Verwaltung prüfen oder bereits vorbereiten. Der Ablauf gilt unabhängig davon, aus welchem Grund gewechselt wird.',
            id: 'fuer-wen-titel',
        }) }}
    </div>
</section>

<section class="l-section l-section--flaeche l-section--streifen" aria-labelledby="ablauf-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Ablauf',
            titel: 'So läuft der *Verwalterwechsel*',
            text: 'Die folgenden Schritte gelten allgemein. Die tatsächliche Reihenfolge und Dauer hängt von Ihrer Beschlusslage und dem bestehenden Verwaltervertrag ab.',
            id: 'ablauf-titel',
        }) }}
        {{ tl.timeline([
            {titel: 'Bestandsaufnahme und Angebot', text: 'Sie schildern Objekt, Größe und aktuelle Situation. Sie erhalten ein schriftliches Angebot der Hausverwaltung Müller GmbH.'},
            {titel: 'Vorbereitung der Beschlussfassung', text: 'Der Verwaltungsbeirat und die Eigentümer bereiten die Abstimmung vor, unter Beachtung der geltenden Einberufungsfristen.'},
            {titel: 'Beschluss in der Eigentümerversammlung', text: 'Die Eigentümerversammlung beschließt über die Bestellung des neuen Verwalters und, soweit erforderlich, über die Abberufung des bisherigen.'},
            {titel: 'Verwaltervertrag', text: 'Die Gemeinschaft schließt den Verwaltervertrag mit der Hausverwaltung Müller GmbH.'},
            {titel: 'Übergabe der Unterlagen und Konten', text: 'Der bisherige Verwalter übergibt Unterlagen, Beschluss-Sammlung und Konten. Wir dokumentieren die Übergabe.'},
            {titel: 'Start der Verwaltung und Information der Eigentümer', text: 'Die laufende Verwaltung beginnt, Eigentümer und Dienstleister werden informiert.'},
        ]) }}
        {{ hvm.zwischen_cta('Ihre Gemeinschaft prüft einen Wechsel? Sie erhalten ein schriftliches Angebot mit Vertragsentwurf als Grundlage für Beirat und Eigentümerversammlung.', {label: 'Wechsel anfragen', url: cta_url('/angebot/', {anlass: 'wechsel'})}, {label: 'Checkliste ansehen', url: '#checkliste-titel'}) }}
    </div>
</section>

<section class="l-section" aria-labelledby="zeitplan-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Zeitplan',
            titel: 'Zeitplan nach Ihrer *Ausgangslage*',
            id: 'zeitplan-titel',
        }) }}
        {{ n.hinweis('Maßgeblich sind Ihre Unterlagen', 'Wie lange ein Verwalterwechsel dauert, hängt von drei Punkten ab: der Beschlusslage Ihrer Gemeinschaft, der Bestellungszeit des bisherigen Verwalters und den Regelungen seines Verwaltervertrags sowie den Einberufungsfristen für die Eigentümerversammlung nach Gesetz und Gemeinschaftsordnung. Wir nennen an dieser Stelle bewusst keine pauschalen Fristen. Prüfen Sie die Fristen anhand Ihrer Unterlagen, im Zweifel mit Unterstützung eines Rechtsanwalts, und tragen Sie Termine mit ausreichendem Vorlauf ein.') }}
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="checkliste-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Übergabe',
            titel: 'Checkliste *Unterlagenübergabe*',
            text: 'Diese Unterlagen benötigt die neue Verwaltung typischerweise vom bisherigen Verwalter. Je nach Objekt kann die Liste im Einzelfall abweichen.',
            id: 'checkliste-titel',
            geteilt: true,
        }) }}
        <ul class="c-checkliste">
            <li>Beschluss-Sammlung</li>
            <li>Niederschriften der Eigentümerversammlungen</li>
            <li>Teilungserklärung und Gemeinschaftsordnung</li>
            <li>Verträge mit Dienstleistern</li>
            <li>Kontenunterlagen und Kontoauszüge</li>
            <li>Wirtschaftspläne, Jahresabrechnungen und Vermögensberichte</li>
            <li>Unterlagen zur Erhaltungsrücklage</li>
            <li>Versicherungsunterlagen</li>
            <li>Pläne und technische Unterlagen</li>
            <li>Schlüssel</li>
        </ul>
    </div>
</section>

<section class="l-section" aria-labelledby="beschluss-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Beschlussfassung',
            titel: 'Abberufung und *Bestellung* durch Beschluss',
            id: 'beschluss-titel',
        }) }}
        {{ n.hinweis('Allgemeiner Hinweis, keine Rechtsberatung', 'Die Abberufung des bisherigen und die Bestellung des neuen Verwalters erfolgen durch Beschluss der Eigentümerversammlung. Mehrheiten, Form und Fristen richten sich nach Gesetz und Gemeinschaftsordnung. Mehr dazu in unseren Wissensbeiträgen.') }}
        <div class="c-karten c-karten--4 c-karten--abstand">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Bestellung und Abberufung des Verwalters', url: '/wissen/verwalter-bestellung-abberufung/', fuss: 'Beitrag lesen', text: 'Voraussetzungen und Ablauf des Beschlusses.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Verwalterwechsel in der WEG: Ablauf, Zeitplan, Unterlagen', url: '/wissen/verwalterwechsel-weg/', fuss: 'Beitrag lesen', text: 'Der Wechsel im Detail, mit Unterlagenübergabe.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Vertragslaufzeit und Beendigung des Verwaltervertrags', url: '/wissen/vertragslaufzeit-verwaltervertrag/', fuss: 'Beitrag lesen', text: 'Laufzeit, Kündigung und Beendigung im Überblick.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Der zertifizierte Verwalter', url: '/wissen/zertifizierter-verwalter/', fuss: 'Beitrag lesen', text: 'Voraussetzungen und Nutzen der Zertifizierung.'}) }}
        </div>
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="mehrwerte-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Service und Konditionen',
            titel: 'Portal, Notdienst und *Rahmenverträge*',
            id: 'mehrwerte-titel',
        }) }}
        {% set portal_zusatz %}{% if firma.portal_url %}Zugang über das Portal der Hausverwaltung.{% else %}{{ placeholder(firma.portal_url_platzhalter) }}{% endif %}{% endset %}
        {% set notfall_zusatz %}Erreichbarkeit außerhalb der Bürozeiten, Nummer {{ firma.notfall_telefon ?: placeholder(firma.notfall_telefon_platzhalter) }}{% endset %}
        <div class="c-karten c-karten--4">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Eigentümerportal mit Ticketsystem', icon: 'portal', url: firma.portal_url ?: '/service/', fuss: 'Zum Portal', text: 'Anliegen und Unterlagen online einsehen und übermitteln.', zusatz: portal_zusatz}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: '24/7-Notdienst', icon: 'notfall', url: '/notfall/', fuss: 'Zur Notfallseite', text: 'Rund um die Uhr erreichbar bei einem Notfall im Objekt.', zusatz: notfall_zusatz}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Rahmenverträge', icon: 'dokument', text: 'Abgestimmte Rahmenverträge für Versicherung, Gas, Strom, Hausmeisterdienste und Messdienst.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Keine Aufnahmegebühr', icon: 'info', text: 'Für den Wechsel zur Hausverwaltung Müller GmbH fällt keine Aufnahmegebühr an.'}) }}
        </div>
    </div>
</section>

<section class="l-section" aria-labelledby="faq-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Häufige Fragen',
            titel: 'Bedenken vor dem *Wechsel*',
            text: 'Die Fragen, die Beiräte und Eigentümer vor einem Verwalterwechsel am häufigsten stellen. Die Antworten sind allgemein gehalten und ersetzen keine Rechtsberatung im Einzelfall.',
            id: 'faq-titel',
            geteilt: true,
        }) }}
        {{ faq.faq([
            {frage: 'Wie viel Aufwand hat der Verwaltungsbeirat mit dem Wechsel?', antwort: 'Der Beirat stellt die Eckdaten des Objekts zusammen, vergleicht Angebote und bereitet mit der Einladung zur Eigentümerversammlung den Beschluss vor. Von der Hausverwaltung Müller GmbH erhalten Sie dafür ein schriftliches Angebot und den Entwurf des Verwaltervertrags. Nach dem Beschluss übernehmen wir die Abstimmung mit dem bisherigen Verwalter zur Übergabe.'},
            {frage: 'Wir haben noch einen laufenden Verwaltervertrag. Ist ein Wechsel trotzdem möglich?', antwort: 'Grundsätzlich ja. Seit der WEG-Reform zum 01.12.2020 kann die Eigentümerversammlung den Verwalter jederzeit durch Beschluss abberufen, ein wichtiger Grund ist nicht erforderlich. Der Verwaltervertrag endet spätestens sechs Monate nach der Abberufung. Ob bis dahin Vergütung geschuldet ist, hängt vom Vertrag und vom Einzelfall ab. Alternativ lässt sich der Wechsel auf das Ende der Bestellungszeit planen. Lassen Sie die Regelungen Ihres Vertrags im Zweifel anwaltlich prüfen.'},
            {frage: 'Wie kommen die Unterlagen vom bisherigen Verwalter zur neuen Verwaltung?', antwort: 'Die Unterlagen gehören der Gemeinschaft der Wohnungseigentümer, der bisherige Verwalter hat sie nach dem Ende seiner Tätigkeit herauszugeben. Die Hausverwaltung Müller GmbH stimmt die Übergabe mit ihm ab, sichtet die Unterlagen anhand der Checkliste und dokumentiert die Übergabe. Fehlende Unterlagen werden festgehalten und nachgefordert.'},
            {frage: 'Wie viel Zeit sollten wir für den Wechsel einplanen?', antwort: 'Eine pauschale Angabe ist nicht möglich. Maßgeblich sind der Termin der nächsten Eigentümerversammlung, die Einberufungsfrist nach Gesetz und Gemeinschaftsordnung, die Bestellungszeit und der Vertrag des bisherigen Verwalters sowie Umfang und Vollständigkeit der Unterlagen. Es empfiehlt sich, Angebote frühzeitig vor der Versammlung einzuholen, in der über den Wechsel beschlossen werden soll.'},
            {frage: 'Was passiert mit laufenden Verträgen des bisherigen Verwalters?', antwort: 'Verträge mit Dienstleistern schließt der Verwalter in der Regel im Namen der Gemeinschaft, sie bestehen deshalb beim Wechsel fort. Sie werden im Rahmen der Übergabe gesichtet. Ob sie fortgeführt, angepasst oder neu vergeben werden, entscheidet die Gemeinschaft.'},
            {frage: 'Fallen für den Wechsel zusätzliche Kosten an?', antwort: 'Die Hausverwaltung Müller GmbH erhebt keine Aufnahmegebühr. Die Vergütung für die laufende Verwaltung ergibt sich aus dem Angebot und dem Verwaltervertrag, den Sie mit dem Angebot als Entwurf erhalten.'},
        ], {offen: 1}) }}
    </div>
</section>

{{ hvm.erreichbarkeit({flaeche: true}) }}

{{ cta.cta_band({
    titel: 'Verwalterwechsel für Ihre *Gemeinschaft* anfragen',
    text: 'Unverbindlich und nur mit den Angaben, die für ein Angebot erforderlich sind.',
    primaer: {label: 'Wechsel anfragen', url: cta_url('/angebot/', {anlass: 'wechsel'})},
    sekundaer: {label: 'Kontakt aufnehmen', url: '/kontakt/'},
    id: 'cta-titel',
}) }}
{% endblock %}
