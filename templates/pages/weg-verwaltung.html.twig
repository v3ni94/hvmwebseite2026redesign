{#
  WEG-Verwaltung: Leistungsumfang, Abgrenzung und Ablauf für Wohnungs­eigentümer­gemeinschaften und Beiräte.
  Leistungsumfang: docs/leistungsverzeichnis.md (aus den Muster-Angeboten, Stand 24.09.2026).
  Grundlage: docs/quellen/masterprompt-relaunch-muellerhv-de.md Abschnitt 3.5, 5, 8; docs/architektur.md Abschnitt 9.
  Rechtsstand: WEMoG. Alle Texte sind Entwürfe, keine Rechtsberatung, Normen bewusst allgemein formuliert.
#}
{% extends 'layouts/base.html.twig' %}

{% import 'components/eyebrow.html.twig' as e %}
{% import 'components/section-head.html.twig' as sh %}
{% import 'components/card.html.twig' as c %}
{% import 'components/timeline.html.twig' as tl %}
{% import 'components/faq.html.twig' as faq %}
{% import 'components/notice.html.twig' as n %}
{% import 'components/cta-band.html.twig' as cta %}
{% import 'pages/_bausteine.html.twig' as hvm %}

{% block hero %}
<section class="c-seitenkopf">
    {% include 'partials/hausumriss.html.twig' with {klasse: 'c-seitenkopf__umriss', zeichnen: true} only %}
    <div class="l-container c-seitenkopf__inhalt">
        {{ e.eyebrow('Leistungen') }}
        <h1>{{ page.heading|trennen }}</h1>
        <p class="c-seitenkopf__text">Die Hausverwaltung Müller GmbH aus {{ firma.anschrift.ort }} verwaltet das gemeinschaftliche Eigentum von <strong>Wohnungs&shy;eigentümer&shy;gemeinschaften</strong>: Eigentümer&shy;versammlung, Wirtschaftsplan und Jahresabrechnung, Umsetzung der Beschlüsse und Erhaltung. Sie erhalten ein schriftliches Angebot mit dem Entwurf des Verwaltervertrags.</p>
        {{ hvm.hero_aktionen({label: 'Angebot anfordern', url: cta_url('/angebot/', {art: 'weg'})}) }}
    </div>
</section>
{% endblock %}

{% block content %}

{{ hvm.vertrauen() }}

<section class="l-section l-section--kompakt" aria-labelledby="fuer-wen-titel">
    <div class="l-container">
        {{ sh.section_head({
            titel: 'Für *Wohnungs­eigentümer­gemeinschaften* und Beiräte',
            text: 'Die WEG-Verwaltung richtet sich an Gemeinschaften der Wohnungseigentümer, unabhängig von der Anzahl der Einheiten. Beauftragt wird die Hausverwaltung Müller GmbH durch Beschluss der Eigentümerversammlung, Ansprechpartner sind in der Regel der Verwaltungsbeirat und die einzelnen Eigentümer.',
            id: 'fuer-wen-titel',
        }) }}
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="leistungsumfang-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Leistungsumfang',
            titel: 'Grundleistungen als *Verwaltungsorgan*',
            text: 'Seit der WEG-Reform (WEMoG) handelt der Verwalter als Organ der Gemeinschaft der Wohnungseigentümer. Die folgenden Leistungen sind in der Regel mit der monatlichen Grundvergütung abgegolten. Maßgeblich ist der individuelle Verwaltervertrag, dessen Entwurf Sie mit dem Angebot erhalten.',
            id: 'leistungsumfang-titel',
            geteilt: true,
        }) }}
        <div class="c-karten">
            {% set kaufmaennisch %}
            <ul class="c-leistungsliste">
                <li>Führung der Konten der Gemeinschaft und Abwicklung des Zahlungsverkehrs</li>
                <li>Sachliche und rechnerische Rechnungsprüfung</li>
                <li>Einzug des Hausgelds im SEPA-Lastschriftverfahren und Überwachung der Zahlungseingänge</li>
                <li>Aufstellung des Gesamt- und Einzelwirtschaftsplans</li>
                <li>Erstellung der Gesamt- und Einzelabrechnung (Jahresabrechnung)</li>
                <li>Mahnwesen bei Zahlungsrückständen</li>
                <li>Jährliche Kassenprüfung und Bereithaltung der Abrechnungsunterlagen zur Einsicht</li>
                <li>Bearbeitung von Eigentümerwechseln</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Kaufmännisch', ton: 'w', nummer: '01', zusatz: kaufmaennisch}) }}
            {% set versammlung %}
            <ul class="c-leistungsliste">
                <li>Einladung und Durchführung der ordentlichen jährlichen Eigentümerversammlung einschließlich Versammlungsvorsitz</li>
                <li>Niederschrift und Führung der Beschluss-Sammlung</li>
                <li>Entscheidungsvorschläge für den Verwaltungsbeirat und Mitwirkung bei der Prüfung von Wirtschaftsplan und Jahresabrechnung</li>
                <li>Teilnahme an Beiratssitzungen in einem vereinbarten Stundenumfang je Jahr</li>
                <li>Überwachung der Haus- und Gemeinschaftsordnung</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Versammlung und Beirat', ton: 'w', nummer: '02', zusatz: versammlung}) }}
            {% set technisch %}
            <ul class="c-leistungsliste">
                <li>Bedarfsgerechte Objektbegehungen zur Überwachung des baulichen Zustands</li>
                <li>Kaufmännische Betreuung laufender Erhaltungsmaßnahmen bis zu einer vertraglich festgelegten Wertgrenze je Einzelmaßnahme</li>
                <li>Abschluss und Kündigung von Liefer-, Wartungs-, Dienstleistungs- und Versicherungsverträgen</li>
                <li>Überwachung von Dienstleistern wie Hausmeister, Reinigung und Gartenpflege</li>
                <li>Abwicklung von Schäden über die Gebäudeversicherungen der Gemeinschaft</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Technisch und Verträge', ton: 'w', nummer: '03', zusatz: technisch}) }}
        </div>
        {{ hvm.zwischen_cta('Passt der Leistungsumfang zu Ihrer Gemeinschaft? Sie erhalten ein schriftliches Angebot mit Vertragsentwurf, ohne Aufnahmegebühr.', {label: 'Angebot anfordern', url: cta_url('/angebot/', {art: 'weg'})}, {label: 'Verwalterwechsel ansehen', url: '/verwalterwechsel/'}) }}
    </div>
</section>

<section class="l-section" aria-labelledby="sonderleistungen-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Sonderleistungen',
            titel: 'Was *gesondert* vergütet wird',
            text: 'Leistungen, die nicht in jedem Jahr oder nicht in jeder Gemeinschaft anfallen, werden in der Regel gesondert vergütet, je nach Leistung nach Zeitaufwand, als Pauschale oder nach Vergütungsbeschluss der Eigentümerversammlung. Die Einzelheiten regelt das Leistungsverzeichnis des Verwaltervertrags.',
            id: 'sonderleistungen-titel',
            geteilt: true,
            aktion: {label: 'Grund- und Sonderleistungen erklärt', url: '/wissen/sonderleistungen-verwaltung/'},
        }) }}
        <div class="c-karten">
            {% set sonder_versammlung %}
            <ul class="c-leistungsliste">
                <li>Zusätzliche Eigentümerversammlungen</li>
                <li>Umlaufbeschlüsse</li>
                <li>Online-Teilnahme an Eigentümerversammlungen nach Beschluss</li>
                <li>Beiratssitzungen über den vereinbarten Stundenumfang hinaus</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Versammlungen', ton: 'm', zusatz: sonder_versammlung}) }}
            {% set sonder_finanzen %}
            <ul class="c-leistungsliste">
                <li>Erstellung des Vermögensberichts</li>
                <li>Umsetzung von Sonderumlagen</li>
                <li>Zusätzliche Rücklagen und Abrechnungskreise</li>
                <li>Erteilung der Verwalterzustimmung, soweit die Gemeinschaftsordnung sie vorsieht</li>
                <li>Bescheinigungen für Steuerermäßigungen</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Finanzen und Verwaltung', ton: 'm', zusatz: sonder_finanzen}) }}
            {% set sonder_bau %}
            <ul class="c-leistungsliste">
                <li>Größere Erhaltungsmaßnahmen oberhalb der Wertgrenze, von der Beschlussvorbereitung bis zur Abnahmebegleitung</li>
                <li>Beschlüsse über Darlehen und Fördermittel</li>
                <li>Bearbeitung von Gewährleistungsansprüchen</li>
                <li>Begleitung von Rechtsstreitigkeiten und Zwangsvollstreckungsverfahren</li>
            </ul>
            {% endset %}
            {{ c.card({titel: 'Bau und Recht', ton: 'm', zusatz: sonder_bau}) }}
        </div>
        <div class="c-karten--abstand">
            {{ n.hinweis('Abgrenzung', 'Rechtsberatung, steuerliche Beratung und bautechnische Beratung sind nicht Teil der Verwaltungsleistung, hierfür verweisen wir an Rechtsanwalt, Steuerberater oder Fachplaner. Übernimmt ein Architekt oder Sachverständiger die Begleitung einer größeren Maßnahme, fallen dafür beim Verwalter in der Regel keine zusätzlichen Kosten an. Die Betreuung des Sondereigentums einzelner vermieteter Wohnungen ist gesondert geregelt, siehe SE-Verwaltung.') }}
        </div>
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="ablauf-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Übernahme',
            titel: 'Ablauf der *Übernahme*',
            text: 'Der Wechsel zur Hausverwaltung Müller GmbH folgt einem geordneten Ablauf. Eine ausführliche Darstellung mit Zeitplan und Unterlagenübergabe finden Sie auf der Seite Verwalterwechsel.',
            id: 'ablauf-titel',
            geteilt: true,
            aktion: {label: 'Verwalterwechsel im Detail', url: '/verwalterwechsel/'},
        }) }}
        {{ tl.timeline([
            {titel: 'Bestandsaufnahme und Angebot', text: 'Sie schildern Objekt und Ausgangslage, Sie erhalten ein schriftliches Angebot.'},
            {titel: 'Beschluss der Eigentümerversammlung', text: 'Die Eigentümerversammlung beschließt über Bestellung und Verwaltervertrag.'},
            {titel: 'Übergabe der Unterlagen', text: 'Der bisherige Verwalter übergibt Beschluss-Sammlung, Konten und Unterlagen.'},
            {titel: 'Start der Verwaltung', text: 'Eigentümer und Dienstleister werden informiert, die laufende Verwaltung beginnt.'},
        ]) }}
    </div>
</section>

<section class="l-section" aria-labelledby="mehrwerte-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Service und Konditionen',
            titel: 'Portal, Notdienst und *Rahmenverträge*',
            id: 'mehrwerte-titel',
        }) }}
        {% set portal_zusatz %}{% if firma.portal_url %}Zugang über das Portal der Hausverwaltung.{% else %}{{ placeholder(firma.portal_url_platzhalter) }}{% endif %}{% endset %}
        {% set notfall_zusatz %}Erreichbarkeit außerhalb der Bürozeiten, Nummer {{ firma.notfall_telefon ?: placeholder(firma.notfall_telefon_platzhalter) }}{% endset %}
        <div class="c-karten c-karten--4">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Eigentümerportal mit Ticketsystem', icon: 'portal', url: firma.portal_url ?: '/service/', fuss: 'Zum Portal', text: 'Abrechnungen, Wirtschaftspläne, Protokolle und Belege digital abrufen, Anliegen online übermitteln.', zusatz: portal_zusatz}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: '24/7-Notdienst', icon: 'notfall', url: '/notfall/', fuss: 'Zur Notfallseite', text: 'Rund um die Uhr erreichbar bei einem Notfall im Objekt.', zusatz: notfall_zusatz}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Rahmenverträge', icon: 'dokument', text: 'Abgestimmte Rahmenverträge für Versicherung, Gas, Strom, Hausmeisterdienste und Messdienst.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Keine Aufnahmegebühr', icon: 'info', text: 'Für den Wechsel zur Hausverwaltung Müller GmbH fällt keine Aufnahmegebühr an.'}) }}
        </div>
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="wissen-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Wissen',
            titel: 'Weiterführende *Beiträge*',
            id: 'wissen-titel',
            aktion: {label: 'Alle Beiträge zu WEG und Beirat', url: '/wissen/?zielgruppe=weg-beirat'},
        }) }}
        <div class="c-karten c-karten--4">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Die Eigentümerversammlung', url: '/wissen/eigentuemerversammlung/', fuss: 'Beitrag lesen', text: 'Einberufung, Ablauf und Niederschrift.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Wirtschaftsplan und Jahresabrechnung', url: '/wissen/wirtschaftsplan-jahresabrechnung/', fuss: 'Beitrag lesen', text: 'Wirtschaftsplan, Jahresabrechnung und Vermögensbericht im Überblick.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Die Erhaltungsrücklage', url: '/wissen/erhaltungsruecklage/', fuss: 'Beitrag lesen', text: 'Zweck und Bemessung der Rücklage.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Beschlussfassung in der Gemeinschaft', url: '/wissen/beschlussfassung-weg/', fuss: 'Beitrag lesen', text: 'Mehrheiten, bauliche Veränderungen und Anfechtung.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Der Verwaltungsbeirat: Aufgaben und Zusammenarbeit', url: '/wissen/verwaltungsbeirat-aufgaben/', fuss: 'Beitrag lesen', text: 'Bestellung, Aufgaben und Zusammenarbeit mit dem Verwalter.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Das Hausgeld: Zusammensetzung und Zahlung', url: '/wissen/hausgeld/', fuss: 'Beitrag lesen', text: 'Zusammensetzung, Beschluss und Fälligkeit des Hausgelds.'}) }}
        </div>
    </div>
</section>

<section class="l-section" aria-labelledby="faq-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Häufige Fragen',
            titel: 'Kurz *erklärt*',
            id: 'faq-titel',
        }) }}
        {{ faq.faq([
            {frage: 'Ist der Verwalter Vertreter der Gemeinschaft oder der einzelnen Eigentümer?', antwort: 'Der Verwalter handelt als Organ der Gemeinschaft der Wohnungseigentümer und setzt deren Beschlüsse um. Die Interessen einzelner Eigentümer vertritt er nicht.'},
            {frage: 'Wie oft findet eine Eigentümerversammlung statt?', antwort: 'Mindestens einmal jährlich. Weitere Versammlungen und die Einberufungsfrist richten sich nach Gesetz und der jeweiligen Gemeinschaftsordnung.'},
            {frage: 'Wie lange läuft der Verwaltervertrag?', antwort: 'In der Regel wird der Verwaltervertrag für die Dauer der Bestellung geschlossen. Wird der Verwalter vorzeitig abberufen, endet der Vertrag spätestens sechs Monate danach. Die Kündigung aus wichtigem Grund bleibt für beide Seiten möglich.'},
            {frage: 'Was passiert mit der Erhaltungsrücklage bei einem Verwalterwechsel?', antwort: 'Die Erhaltungsrücklage ist Vermögen der Gemeinschaft und bleibt es auch beim Wechsel. Die neue Verwaltung erhält die Kontenunterlagen und die Verfügungsberechtigung für die Konten der Gemeinschaft.'},
        ]) }}
    </div>
</section>

{{ hvm.erreichbarkeit({flaeche: true}) }}

{{ cta.cta_band({
    titel: 'Angebot für Ihre *Eigentümergemeinschaft* anfordern',
    text: 'Unverbindlich und nur mit den Angaben, die für ein Angebot erforderlich sind.',
    primaer: {label: 'Angebot anfordern', url: cta_url('/angebot/', {art: 'weg'})},
    sekundaer: {label: 'Kontakt aufnehmen', url: '/kontakt/'},
    id: 'cta-titel',
}) }}
{% endblock %}
