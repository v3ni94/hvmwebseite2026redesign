{#
  Startseite, Referenz-Prototyp des Designsystems (MP 3.5, 5). Alle Texte sind Entwürfe.
  Aussagen aus der Altseite ohne Beleg werden mit dem placeholder()-Muster markiert (docs/architektur.md Abschnitt 8).
  24/7-Notdienst, Eigentümerportal, Rahmenverträge und keine Aufnahmegebühr sind laut
  docs/auftraggeber-angaben.md bestätigt, hauseigene Techniker nicht. Offen bleiben Notfallnummer und Portal-URL.
  FAQ-Auszug: Wortlaut aus content/faq (weg-beirat, vermieter-investoren, kosten-vertrag, mieter), ohne Markdown-Links.
#}
{% extends 'layouts/base.html.twig' %}

{% import 'components/button.html.twig' as b %}
{% import 'components/eyebrow.html.twig' as e %}
{% import 'components/section-head.html.twig' as sh %}
{% import 'components/bento.html.twig' as bento %}
{% import 'components/card.html.twig' as c %}
{% import 'components/kennzahlen.html.twig' as kz %}
{% import 'components/timeline.html.twig' as tl %}
{% import 'components/faq.html.twig' as faq %}
{% import 'components/cta-band.html.twig' as cta %}
{% import 'components/placeholder.html.twig' as ph %}

{% block hero %}
<section class="c-hero c-hero--mit-keil c-hero--mit-kennzahlen">
    <div class="c-hero__umriss-rahmen" aria-hidden="true">
        {% include 'partials/hausumriss.html.twig' with {klasse: 'c-hero__umriss', zeichnen: true, parallaxe: true} only %}
    </div>
    <div class="l-container">
        <div class="c-hero__inhalt">
            {{ e.eyebrow('Hausverwaltung in ' ~ firma.anschrift.ort, {klasse: 'u-auftritt'}) }}
            <hgroup class="c-display c-hero__titel u-auftritt u-auftritt--2" data-kinetisch>
                {#- h1 und Fortsetzung ohne Leerraum dazwischen, damit das Komma direkt anschließt -#}
                <h1>Hausverwaltung für Eigentümer und Investoren</h1><p>, <strong>strukturiert</strong> und nachvollziehbar.</p>
            </hgroup>
            <p class="c-hero__lead u-auftritt u-auftritt--3">WEG-Verwaltung, Mietverwaltung und Sondereigentumsverwaltung aus {{ firma.anschrift.ort }}, {{ firma.gruendung_text }}. Dazu Vermietung, Verkauf und Wertgutachten.</p>
            <div class="c-aktionen u-auftritt u-auftritt--4">
                {{ b.button(nav.cta.label, nav.cta.url, {variante: 'primaer', icon: 'pfeil'}) }}
                {{ b.button(nav.cta_sekundaer.label, nav.cta_sekundaer.url, {variante: 'sekundaer'}) }}
            </div>
        </div>

        <div class="c-hero__kennzahlen is-orange">
            <h2 class="u-visually-hidden">Kennzahlen</h2>
            {% set mitglieder = firma.mitgliedschaften|map(m => m.kurz)|join(' und ') %}
            {{ kz.kennzahlen([
                {wert: kennzahlen.einheiten, zaehler: true, label: 'Verwaltungseinheiten'},
                {wert: kennzahlen.objekte, zaehler: true, label: 'Objekte in der Verwaltung'},
                {wert: kennzahlen.gruendungsjahr, vorsatz: 'seit', label: 'Gründungsjahr'},
                {wert: mitglieder, text: true, label: 'Mitgliedschaften in Fachverbänden'},
            ], {stichtag: kennzahlen.stichtag, quelle: kennzahlen.quelle}) }}
            <span class="c-keil c-keil-uebergang" aria-hidden="true"></span>
        </div>
    </div>
</section>
{% endblock %}

{% block content %}
{# Leistungen als Bento-Grid #}
<section class="l-section" aria-labelledby="leistungen-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Leistungen',
            titel: 'Verwaltung und Service für *Ihre Immobilie*',
            text: 'Von der Verwaltung des Gemeinschaftseigentums bis zur Vermietung einzelner Wohnungen. Wählen Sie den Bereich, der zu Ihrer Immobilie passt.',
            id: 'leistungen-titel',
            geteilt: true,
        }) }}
        {{ bento.bento([
            {titel: 'WEG-Verwaltung', url: '/weg-verwaltung/', ton: 'h', breite: 7, hoch: true, gross: true,
             text: 'Verwaltung des gemeinschaftlichen Eigentums für Wohnungseigentümergemeinschaften: Eigentümerversammlung, Wirtschaftsplan, Jahresabrechnung, Erhaltung und Umsetzung der Beschlüsse.'},
            {titel: 'Mietverwaltung', url: '/mietverwaltung/', ton: 'v', breite: 5,
             text: 'Betreuung von Mietobjekten für Vermieter und Investoren: Mietverhältnisse, Mieteingang, Betriebskostenabrechnung und Instandhaltung.'},
            {titel: 'SE-Verwaltung', url: '/se-verwaltung/', ton: 'm', breite: 5,
             text: 'Sondereigentumsverwaltung für Kapitalanleger: Betreuung der vermieteten Eigentumswohnung neben der WEG-Verwaltung.'},
            {titel: 'Verwalterwechsel', url: '/verwalterwechsel/', ton: 'o', breite: 5, keil: true, fuss: 'Ablauf ansehen',
             text: 'Geordneter Wechsel für Eigentümergemeinschaften: Beschlussfassung, Übergabe der Unterlagen und Start der Verwaltung.'},
            {titel: 'Vermietung', url: '/vermietung/', ton: 'w', breite: 7,
             text: 'Vermietung im Auftrag der Eigentümer: Vermarktung, Besichtigungen, Auswahl der Mieter und Mietvertrag.'},
            {titel: 'Verkauf', url: '/verkauf/', ton: 'u', breite: 7,
             text: 'Verkauf von Wohnungen und Häusern: Bewertung, Vermarktung und Begleitung bis zum Abschluss.'},
            {titel: 'Wertgutachten', url: '/wertgutachten/', ton: 'w', breite: 5,
             text: 'Wertermittlung für Immobilien, zum Beispiel vor einem Verkauf, im Erbfall oder bei einer Vermögensaufteilung.'},
        ]) }}
    </div>
</section>

{# Prozess: So läuft der Verwalterwechsel, mit orangem Farbstreifen als Sektionsübergang #}
<section class="l-section l-section--flaeche l-section--streifen" aria-labelledby="wechsel-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Verwalterwechsel',
            titel: 'So läuft der *Verwalterwechsel*',
            text: 'Ein Wechsel folgt klaren Schritten. Termine und Fristen richten sich nach dem bestehenden Verwaltervertrag und den Beschlüssen Ihrer Gemeinschaft.',
            id: 'wechsel-titel',
            geteilt: true,
            aktion: {label: 'Ablauf im Detail', url: '/verwalterwechsel/'},
        }) }}
        {{ tl.timeline([
            {titel: 'Anfrage und Bestandsaufnahme', text: 'Sie schildern Objekt, Größe und aktuelle Situation. Wir sichten die Eckdaten, etwa die Laufzeit des bestehenden Verwaltervertrags.'},
            {titel: 'Angebot und Vorstellung', text: 'Sie erhalten ein schriftliches Angebot. Auf Wunsch stellen wir uns dem Verwaltungsbeirat oder der Eigentümerversammlung vor.'},
            {titel: 'Beschluss', text: 'Die Eigentümerversammlung beschließt über die Bestellung des neuen Verwalters und über den Verwaltervertrag.'},
            {titel: 'Übergabe', text: 'Der bisherige Verwalter übergibt Unterlagen, Beschluss-Sammlung, Kontenübersicht und Schlüssel. Die Übergabe wird dokumentiert.'},
            {titel: 'Beginn der Verwaltung', text: 'Eigentümer, Dienstleister und Versorger werden informiert. Die laufende Verwaltung beginnt.'},
        ]) }}
    </div>
</section>

{# Service-Einstieg für Mieter und Eigentümer #}
<section class="l-section" aria-labelledby="service-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Service',
            titel: 'Für Mieter und *Eigentümer*',
            text: 'Der direkte Weg zum richtigen Kanal: Portal, Schadensmeldung, Notfall und Kontakt.',
            id: 'service-titel',
            geteilt: true,
        }) }}
        {% set portal_zusatz %}{% if firma.portal_url %}Zugang über das Portal der Hausverwaltung.{% else %}{{ placeholder(firma.portal_url_platzhalter) }}{% endif %}{% endset %}
        {% set notfall_zusatz %}Notdienst rund um die Uhr, Nummer {{ firma.notfall_telefon ?: placeholder(firma.notfall_telefon_platzhalter) }}{% endset %}
        <div class="c-karten c-karten--4">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Eigentümerportal', icon: 'portal', url: firma.portal_url ?: '/service/', fuss: 'Zum Portal', text: 'Unterlagen einsehen und Anliegen über das Ticketsystem übermitteln.', zusatz: portal_zusatz}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Schadensmeldung', icon: 'schaden', url: '/service/', fuss: 'Schaden melden', text: 'Schäden in der Wohnung oder am Gemeinschaftseigentum strukturiert melden.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Notfall', icon: 'notfall', url: '/notfall/', fuss: 'Zur Notfallseite', text: 'Wasserrohrbruch, Heizungsausfall oder Sturmschaden: was im Notfall zu tun ist.', zusatz: notfall_zusatz}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Kontakt', icon: 'kontakt', url: '/kontakt/', fuss: 'Kontakt aufnehmen', text: 'Fragen zu Verwaltung, Abrechnung oder Vertrag an unser Team.'}) }}
        </div>
    </div>
</section>

{# Kundenstimmen: nur mit belegbarer Herkunft. Die Variable kundenstimmen liefert config/kundenstimmen.php. #}
{% set stimmen = kundenstimmen|default([]) %}
{% if stimmen|length > 0 %}
<section class="l-section l-section--kompakt" aria-labelledby="stimmen-titel">
    <div class="l-container">
        {{ sh.section_head({eyebrow: 'Kundenstimmen', titel: 'Stimmen unserer *Kunden*', id: 'stimmen-titel'}) }}
        <div class="c-stimmen">
            {% for stimme in stimmen %}
            <figure class="c-stimme" data-einblenden>
                <blockquote><p>{{ stimme.text }}</p></blockquote>
                <figcaption>{{ stimme.autor }}, {{ stimme.quelle }}, {{ datum(stimme.datum) }}</figcaption>
            </figure>
            {% endfor %}
        </div>
    </div>
</section>
{% elseif not app.is_production %}
<section class="l-section l-section--kompakt" aria-labelledby="stimmen-titel">
    <div class="l-container">
        {{ sh.section_head({eyebrow: 'Kundenstimmen', titel: 'Stimmen unserer *Kunden*', id: 'stimmen-titel'}) }}
        {{ ph.block('Abschnitt in der Produktion ausgeblendet', 'Kundenstimmen mit belegbarer Herkunft ergänzen', {erklaerung: 'Nur echte Bewertungen mit Quelle und Datum, keine Stimmen von Angehörigen oder Mitarbeitern (config/kundenstimmen.php).'}) }}
    </div>
</section>
{% endif %}

{# FAQ-Auszug #}
<section class="l-section l-section--flaeche" aria-labelledby="faq-titel">
    <div class="l-container c-start-faq">
        {{ sh.section_head({
            eyebrow: 'Wissen und FAQ',
            titel: 'Häufige *Fragen*',
            text: 'Kurze Antworten auf häufige Fragen. Ausführliche Beiträge für Eigentümergemeinschaften, Vermieter und Mieter finden Sie im Wissensbereich.',
            id: 'faq-titel',
            aktion: {label: 'Zum Wissensbereich', url: '/wissen/'},
        }) }}
        {{ faq.faq([
            {frage: 'Wie läuft ein Verwalterwechsel ab?', antwort: 'Die Eigentümer beschließen in einer Versammlung über die Abberufung des bisherigen und die Bestellung des neuen Verwalters sowie über den Verwaltervertrag. Anschließend übergibt der bisherige Verwalter die Unterlagen, und die Verfügungsberechtigung für die Konten der Gemeinschaft wird umgestellt. Der Stichtag des Wechsels sollte im Beschluss eindeutig festgelegt sein.'},
            {frage: 'Brauche ich neben dem WEG-Verwalter eine Sondereigentumsverwaltung?', antwort: 'Der WEG-Verwalter ist für das gemeinschaftliche Eigentum zuständig, nicht für Ihr Mietverhältnis. Mieteinzug, Betriebskostenabrechnung gegenüber dem Mieter und die Betreuung der Wohnung übernimmt die Sondereigentumsverwaltung, sofern Sie diese Aufgaben nicht selbst erledigen.'},
            {frage: 'Was kostet eine Hausverwaltung?', antwort: 'Das hängt von Art der Verwaltung, Größe, Zustand und technischer Ausstattung des Objekts ab. Üblich ist eine monatliche Grundvergütung je Einheit und eine gesonderte Vergütung für klar beschriebene Sonderleistungen. Ein belastbarer Preis setzt Angaben zum Objekt voraus, deshalb erstellt die Hausverwaltung Müller GmbH ein individuelles Angebot.'},
            {frage: 'Erhebt die Hausverwaltung Müller GmbH eine Aufnahmegebühr?', antwort: 'Nein. Die Hausverwaltung Müller GmbH erhebt keine Aufnahmegebühr bei der Übernahme einer Verwaltung.'},
            {frage: 'Wie melde ich einen Schaden in meiner Wohnung?', antwort: 'Melden Sie den Schaden unverzüglich Ihrem Vermieter oder der von ihm beauftragten Verwaltung, am besten schriftlich mit Beschreibung, Fotos und Ihren Erreichbarkeiten. Bei der Hausverwaltung Müller GmbH nutzen Sie dafür die E-Mail oder, soweit Sie einen Zugang haben, das Portal mit Ticketsystem.'},
        ], {offen: 1}) }}
        <div class="c-karten c-karten--4 c-karten--abstand">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Die Eigentümerversammlung', url: '/wissen/eigentuemerversammlung/', fuss: 'Beitrag lesen', text: 'Einberufung, Ablauf und Niederschrift.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Mietverwaltung: Aufgaben und Leistungsumfang', url: '/wissen/mietverwaltung-leistungen/', fuss: 'Beitrag lesen', text: 'Der Leistungsumfang im Überblick.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Eine Immobilie verkaufen: der Ablauf', url: '/wissen/immobilie-verkaufen-ablauf/', fuss: 'Beitrag lesen', text: 'Vorbereitung, Vermarktung und Notartermin im Überblick.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Einen Schaden melden', url: '/wissen/schadensmeldung/', fuss: 'Beitrag lesen', text: 'Wege der Schadensmeldung und was Sie angeben sollten.'}) }}
        </div>
    </div>
</section>

{{ cta.cta_band({
    titel: 'Angebot für Ihre *Immobilie* anfordern',
    text: 'Unverbindlich und nur mit den Angaben, die für ein Angebot erforderlich sind.',
    primaer: nav.cta,
    sekundaer: {label: 'Kontakt aufnehmen', url: '/kontakt/'},
    id: 'cta-titel',
}) }}
{% endblock %}
