{#
  Kontakt: Hauptsitz, Kontaktformular (Partial eines anderen Agenten), Anfahrt als Text mit externem
  OpenStreetMap-Link (keine Einbettung), Hausumriss als Hintergrundmotiv (MP 3.4.3). Grundlage:
  MP Abschnitt 1 (Ziel 3), 2, 5, 8; docs/architektur.md Abschnitt 9.
#}
{% extends 'layouts/base.html.twig' %}

{% import 'components/eyebrow.html.twig' as e %}
{% import 'components/section-head.html.twig' as sh %}
{% import 'components/card.html.twig' as c %}
{% import 'components/cta-band.html.twig' as cta %}

{% block hero %}
<section class="c-seitenkopf">
    {% include 'partials/hausumriss.html.twig' with {klasse: 'c-seitenkopf__umriss', zeichnen: true} only %}
    <div class="l-container c-seitenkopf__inhalt">
        {{ e.eyebrow('Kontakt') }}
        <h1>{{ page.heading }}</h1>
        <p class="c-seitenkopf__text">Hauptsitz Rheinpromenade 13, {{ firma.anschrift.plz }} {{ firma.anschrift.ort }}. Schreiben Sie uns über das Kontaktformular oder nutzen Sie die Angaben unten.</p>
    </div>
</section>
{% endblock %}

{% block content %}

<section class="l-section l-section--kompakt" aria-label="Kontaktangaben und Kontaktformular">
    <div class="l-container l-grid">
        <div class="l-span-4 c-kontakt-adresse">
            <h2 class="c-section-head__titel">Anschrift</h2>
            <address class="c-prosa">
                {{ firma.name }}<br>
                {{ firma.anschrift.strasse }}<br>
                {{ firma.anschrift.plz }} {{ firma.anschrift.ort }}
            </address>

            <h2 class="c-section-head__titel u-mt-6">Telefon und E-Mail</h2>
            <p class="c-prosa">
                {% if firma.telefon %}
                Telefon: <a href="{{ tel_href(firma.telefon) }}">{{ firma.telefon }}</a><br>
                {% else %}
                Telefon: {{ placeholder(firma.telefon_platzhalter) }}<br>
                {% endif %}
                E-Mail: <a href="mailto:{{ firma.email }}">{{ firma.email }}</a>
            </p>

            <h2 class="c-section-head__titel u-mt-6">Bürozeiten</h2>
            <p class="c-prosa">{{ placeholder('Bürozeiten ergänzen') }}</p>

            <h2 class="c-section-head__titel u-mt-6">Anfahrt</h2>
            <p class="c-prosa">
                Der Hauptsitz liegt in {{ firma.anschrift.ort }}, Anschrift {{ firma.anschrift.strasse }}, {{ firma.anschrift.plz }} {{ firma.anschrift.ort }}.
                <a href="https://www.openstreetmap.org/search?query={{ (firma.anschrift.strasse ~ ', ' ~ firma.anschrift.plz ~ ' ' ~ firma.anschrift.ort)|url_encode }}" rel="noopener" target="_blank">Route auf OpenStreetMap ansehen<span class="u-visually-hidden"> (öffnet in neuem Tab)</span></a>
            </p>
        </div>

        <div class="l-span-8 c-kontakt-formular">
            <h2 class="c-section-head__titel u-visually-hidden">Kontaktformular</h2>
            {% include 'partials/forms/kontakt-form.html.twig' ignore missing %}
        </div>
    </div>
</section>

<section class="l-section l-section--flaeche" aria-labelledby="weitere-anliegen-titel">
    <div class="l-container">
        {{ sh.section_head({
            eyebrow: 'Weitere Anliegen',
            titel: 'Verwaltungsanfrage oder *Notfall*?',
            id: 'weitere-anliegen-titel',
            geteilt: true,
        }) }}
        <div class="c-karten c-karten--4">
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Verwaltungsanfrage', icon: 'dokument', url: cta_url('/angebot/'), fuss: 'Angebot anfordern', text: 'Anfrage für WEG-Verwaltung, Mietverwaltung oder SE-Verwaltung über das Angebotsformular.'}) }}
            {{ c.card({klasse: 'c-karte--kompakt', titel: 'Notfall im Objekt', icon: 'notfall', url: '/notfall/', fuss: 'Zur Notfallseite', text: 'Wasserrohrbruch, Heizungsausfall oder Sturmschaden: was im Notfall zu tun ist.'}) }}
        </div>
    </div>
</section>

{{ cta.cta_band({
    titel: 'Nachricht an die *Hausverwaltung Müller*',
    text: 'Wir melden uns nach Eingang Ihrer Nachricht zurück.',
    primaer: {label: 'Angebot anfordern', url: cta_url('/angebot/')},
    sekundaer: {label: 'Zum Service', url: '/service/'},
    id: 'cta-titel',
}) }}
{% endblock %}
