{#
  Interne Benachrichtigung an LEAD_NOTIFY_TO. Enthält bewusst keine Namen, Kontaktdaten oder Nachricht,
  auch nicht im Betreff (ContactService::notifySubject).
#}
{% extends 'emails/layout.html.twig' %}

{% block inhalt %}
<p style="margin:0 0 4px 0;font-size:13px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;">Neue Kontaktanfrage</p>
<p style="margin:0 0 20px 0;font-size:22px;line-height:1.3;font-weight:300;">{{ anliegen_label }}</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;font-size:15px;">
    {% set zeilen = [
        ['Anliegen', anliegen_label],
        ['Quelle', anfrage.source ?: 'unbekannt'],
        ['Eingang', datum(eingang) ~ ', ' ~ eingang|date('H:i', 'Europe/Berlin') ~ ' Uhr'],
        ['Kennung', anfrage.uuid],
    ] %}
    {% for z in zeilen %}
    <tr>
        <td style="padding:8px 12px 8px 0;border-bottom:1px solid #D7D8DA;width:42%;font-weight:600;vertical-align:top;">{{ z[0] }}</td>
        <td style="padding:8px 0;border-bottom:1px solid #D7D8DA;vertical-align:top;">{{ z[1] }}</td>
    </tr>
    {% endfor %}
</table>
<p style="margin:16px 0 0 0;font-size:13px;">Name, Kontaktdaten und Nachricht stehen aus Datenschutzgründen nur im Admin-Bereich.</p>
{% endblock %}
